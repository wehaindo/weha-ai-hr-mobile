# ===========================================================================
# WEHA Device Framework — environment configuration
#
# Copy this file to `.env.local` (gitignored) and adjust.
#
# HOW LOADING WORKS — read first:
#
#   1. Next.js (`npm run dev` / `npm run build` / `npm run electron:dev`,
#      `cap:sync`, `electron:build` — anything that runs `next dev|build`)
#      auto-loads this file from the project root. No other tool does.
#   2. NEXT_PUBLIC_* values are INLINED into the static `out/` bundle AT
#      BUILD TIME. Changing them requires a rebuild to take effect.
#      (Existing shell env vars win over this file; the package.json scripts
#      set NEXT_PUBLIC_APP_TARGET via cross-env, so that one always wins.)
#   3. Electron main does NOT read this file. Values it needs (Google OAuth)
#      must be exported in your shell before `npm run electron:dev|build`.
#   4. Standalone node scripts (scripts/*.js) do NOT read this file either —
#      export their vars in your shell when running them.
#   5. NEVER store secrets that end up in device.config.ts — it is bundled
#      into the client. NEXT_PUBLIC_* is public by definition.
#
# Also: the dev-server port is NOT an env var — it lives in device.config.ts
# (`port: 3180`) and must match package.json scripts. init-app.ts rewrites both.
# ===========================================================================


# ---------------------------------------------------------------------------
# Build target — decides which feature modules ship in the bundle
# (src/lib/app-target.ts → device.config.ts module profiles).
#
#   web        → minimal profile (browser / PWA)
#   electron   → full profile    (desktop)
#   cap-mobile → minimal profile (Capacitor phone)
#   cap-tablet → full profile    (Capacitor tablet)
#
# Normally LEAVE COMMENTED: the package.json scripts pin it per build via
# cross-env (dev/build = web, electron:* = electron, cap:sync = cap-tablet,
# cap:sync:mobile = cap-mobile) and the script value overrides this file.
# Set it here only for ad-hoc `npx next dev|build` runs. Unknown/missing → web.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_APP_TARGET=web


# ---------------------------------------------------------------------------
# WEHA framework (weha-framework) — base URL used for BOTH:
#   - ERP sync: DeviceClient activation + /api/device/* polling
#   - Mobile auth: /api/mobile/v1/auth/* (password + OTP login)
# Local dev: http://localhost:3178
# Requires `npm run build` again after changing (inlined at build time).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ERP_BASE_URL=https://erp.example.com


# ---------------------------------------------------------------------------
# WEHA AI Realtime gateway (Socket.IO, default port 4002).
# Runtime feature switch lives in device.config.ts (modules.aiRealtime);
# the device credential (whrt_ token) is stored per-device in device_settings
# under `aiRealtime.token` — never here. See docs/AI-REALTIME.md.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AI_REALTIME_URL=http://localhost:4002


# ---------------------------------------------------------------------------
# Renderer app-info overrides (read by src/platform/renderer-bridge.ts).
# Defaults come from device.config.ts: "Device Framework" / "1.0.0".
# Only uncomment if you want to override — an empty value is NOT the default.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_APP_NAME=Device Framework
# NEXT_PUBLIC_APP_VERSION=1.0.0


# ---------------------------------------------------------------------------
# Electron MAIN process only — Google OAuth desktop flow
# (electron/services/cloud.ts: Google Sheets / Drive cloud sync).
#
# Electron does NOT load .env files. Export these in your shell before
# `npm run electron:dev` / `npm run electron:build`:
#
#   PowerShell:  $env:GOOGLE_CLIENT_ID="...." ; $env:GOOGLE_CLIENT_SECRET="...."
#   cmd:         set GOOGLE_CLIENT_ID=... && set GOOGLE_CLIENT_SECRET=...
#
# The OAuth client should be of type "Desktop app" in Google Cloud Console.
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# Dev tooling — live AI-Realtime monitor (scripts/monitor-ai-realtime.js).
# Plain node script: it does NOT read this file; export in your shell:
#
#   PowerShell:  $env:AI_RT_TOKEN="whrt_..." ; $env:AI_RT_TOPIC="tenant:default:device.events"
#   cmd:         set AI_RT_TOKEN=whrt_... && set AI_RT_TOPIC=tenant:default:device.events
#   then:        node scripts/monitor-ai-realtime.js
# ---------------------------------------------------------------------------
# AI_RT_URL=http://localhost:4002
# AI_RT_TOKEN=
# AI_RT_TOPIC=tenant:default:device.events


# ---------------------------------------------------------------------------
# Playwright (playwright.config.ts) reads CI — but it is provided by your CI
# provider. Do NOT set it locally: CI=1 enables forbids, 2 retries and stops
# reusing an existing dev server.
# ---------------------------------------------------------------------------
# CI=
