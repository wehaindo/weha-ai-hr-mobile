# Copy to `.env.local` (gitignored) and adjust. Next.js loads it automatically
# for `npm run dev` / `npm run build` / `npm run electron:dev`.
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the static bundle AT BUILD
# TIME — run `npm run build` again after changing them.

# ---------------------------------------------------------------------------
# WEHA framework (weha-framework) — base URL used for BOTH ERP sync
# (DeviceClient activation + /api/device/*) and mobile auth
# (/api/mobile/v1/auth/*). Local dev: http://localhost:3178
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ERP_BASE_URL=https://erp.example.com

# ---------------------------------------------------------------------------
# WEHA AI Realtime gateway (Socket.IO, default port 4002)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AI_REALTIME_URL=http://localhost:4002

# ---------------------------------------------------------------------------
# App info overrides for the renderer (defaults: "Device Framework" / "1.0.0").
# Only uncomment if you want to override — an empty value is NOT the default.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_APP_NAME=Device Framework
# NEXT_PUBLIC_APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Electron main process only (electron/services/cloud.ts — Google OAuth
# desktop flow). Electron does NOT read .env itself: export these in your
# shell before `npm run electron:dev` / `npm run electron:build`.
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Dev tooling: scripts/monitor-ai-realtime.js (node scripts/monitor-ai-realtime.js)
# ---------------------------------------------------------------------------
# AI_RT_URL=http://localhost:4002
# AI_RT_TOKEN=
# AI_RT_TOPIC=tenant:default:device.events
