{
  "name": "weha-device-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable device-app framework: Next.js static export + Electron + Capacitor, offline-first SQLite, PIN auth, themes, ERP sync",
  "main": "electron/dist/electron/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "dev": "cross-env NEXT_PUBLIC_APP_TARGET=web next dev --port 3180",
    "build": "cross-env NEXT_PUBLIC_APP_TARGET=web next build",
    "preview": "npx --yes serve out -l 3180",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && cross-env NEXT_PUBLIC_APP_TARGET=electron concurrently \"next dev --port 3180\" \"wait-on http://localhost:3180 && electron .\"",
    "electron:build": "cross-env NEXT_PUBLIC_APP_TARGET=electron next build && npm run electron:compile && electron-builder",
    "cap:sync": "cross-env NEXT_PUBLIC_APP_TARGET=cap-tablet next build && cap sync",
    "cap:sync:mobile": "cross-env NEXT_PUBLIC_APP_TARGET=cap-mobile next build && cap sync",
    "cap:android": "cap run android",
    "cap:ios": "cap run ios",
    "init-app": "tsx scripts/init-app.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@shadcn/react": "^0.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fabric": "^7.4.0",
    "framer-motion": "^13.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "react-simple-keyboard": "^3.8.257",
    "recharts": "^3.8.0",
    "socket.io-client": "^4.8.4",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
